                <Properties>
                    <string name="Name">localhost_client</string>
                    <ProtectedString name="Source">local Messages = require(script.Parent.Parent.bridge.messages)
local DEFAULT_HOST = &quot;http://127.0.0.1:49321&quot;
function buildRequest(command, payload)
    return {url = DEFAULT_HOST, message = Messages.makeMessage(command, payload)}
end
function ping(payload)
    return buildRequest(Messages.SyncCommand.Doctor, payload)
end
