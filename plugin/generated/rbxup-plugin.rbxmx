            <Item class="ModuleScript" referent="RBX12">
                <Properties>
                    <string name="Name">bundle_planner</string>
                    <ProtectedString name="Source">local Defaults = require(script.Parent.Parent.roblox.defaults)

function classifyChild(child)
    if Defaults.BundleableClassNames[child.ClassName] then
        return &quot;bundleable&quot;
    end

    return &quot;readable&quot;
end

function planChildren(children, threshold)
    local readable = {}
    local groups = {}

    for _, child in children do
        local kind = classifyChild(child)
        if kind == &quot;readable&quot; then
            table.insert(readable, child)
        else
            local className = string.lower(child.ClassName)
            local bucket = groups[className]
            if bucket == nil then
                bucket = {}
                groups[className] = bucket
            end
            table.insert(bucket, child)
        end
    end

    local bundled = {}
    local exploded = {}

    for className, bucket in groups do
        if #bucket &gt;= threshold then
            bundled[className] = bucket
        else
            for _, child in bucket do
                table.insert(exploded, child)
            end
        end
    end

    return {
        readable = readable,
        bundled = bundled,
        exploded = exploded,
    }
end

return {
    classifyChild = classifyChild,
    planChildren = planChildren,
}
</ProtectedString>
                </Properties>
            </Item>
            <Item class="ModuleScript" referent="RBX13">
                <Properties>
                    <string name="Name">deserializer</string>
                    <ProtectedString name="Source">local TypeCodec = require(script.Parent.Parent.roblox.type_codec)

function applyProperties(instance, properties)
    for propertyName, encoded in properties do
        local ok, decoded = pcall(TypeCodec.decodeValue, encoded)
        if ok then
            pcall(function()
                instance[propertyName] = decoded
            end)
        end
    end
end

return {
    applyProperties = applyProperties,
}
</ProtectedString>
                </Properties>
            </Item>
            <Item class="ModuleScript" referent="RBX14">
                <Properties>
                    <string name="Name">serializer</string>
                    <ProtectedString name="Source">local StableIds = require(script.Parent.Parent.roblox.stable_ids)
local TypeCodec = require(script.Parent.Parent.roblox.type_codec)

function serializeInstance(instance)
    local id = StableIds.getStableId(instance)
    local encodedName = TypeCodec.encodeValue(instance.Name)

    return {
        format = &quot;xup&quot;,
        version = 1,
        id = id,
        className = instance.ClassName,
        name = instance.Name,
        properties = {
            Name = encodedName,
        },
        attributes = {},
        tags = {},
    }
end

return {
    serializeInstance = serializeInstance,
}
</ProtectedString>
                </Properties>
            </Item>
            <Item class="ModuleScript" referent="RBX15">
                <Properties>
                    <string name="Name">sync_engine</string>
                    <ProtectedString name="Source">local BundlePlanner = require(script.Parent.Parent.sync.bundle_planner)
local Serializer = require(script.Parent.Parent.sync.serializer)
local TreeWalker = require(script.Parent.Parent.sync.tree_walker)
local DEFAULT_SYNC_CONFIG = table.freeze({bundleThreshold = 20, bundleGrouping = &quot;className&quot;, smallBundleBehavior = &quot;explode&quot;})
function previewPull(root)
    local children = root:GetChildren()
    local plan = BundlePlanner.planChildren(children, DEFAULT_SYNC_CONFIG.bundleThreshold)
    local nodes = TreeWalker.walkInstanceTree(root)
    return {root = Serializer.serializeInstance(root), plan = plan, nodes = nodes}
end
return {DEFAULT_SYNC_CONFIG = DEFAULT_SYNC_CONFIG, previewPull = previewPull}
</ProtectedString>
                </Properties>
            </Item>
            <Item class="ModuleScript" referent="RBX16">
                <Properties>
                    <string name="Name">tree_walker</string>
                    <ProtectedString name="Source">local StableIds = require(script.Parent.Parent.roblox.stable_ids)

function walkInstanceTree(root)
    local results = {}

    local function visit(node)
        local id = StableIds.getStableId(node)
        table.insert(results, {
            id = id,
            className = node.ClassName,
            name = node.Name,
            childCount = #node:GetChildren(),
        })

        for _, child in node:GetChildren() do
            visit(child)
        end
    end

    visit(root)
    return results
end

return {
    walkInstanceTree = walkInstanceTree,
}
</ProtectedString>
