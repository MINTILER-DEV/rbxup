{
  "include": [
    "src/**/*.xl"
  ],
  "outDir": "generated",
  "baseDir": "src",
  "target": "roblox",
  "taskAdapter": "roblox",
  "robloxOutput": {
    "projectRbxmx": {
      "enabled": true,
      "path": "generated/rbxup-plugin.rbxmx",
      "rootName": "rbxup",
      "rootClassName": "Folder"
    }
  },
  "paths": {
    "@sync": "./src/sync",
    "@roblox": "./src/roblox",
    "@bridge": "./src/bridge",
    "@ui": "./src/ui"
  }
}