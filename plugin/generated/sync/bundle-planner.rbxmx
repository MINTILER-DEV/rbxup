<roblox xmlns:xmime="http://www.w3.org/2005/05/xmlmime" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://www.roblox.com/roblox.xsd" version="4">
    <Item class="ModuleScript" referent="RBX0">
        <Properties>
            <string name="Name">bundle-planner</string>
            <ProtectedString name="Source">local Defaults = require(script.Parent.Parent.roblox.defaults)

function classifyChild(child)
    if Defaults.BundleableClassNames[child.ClassName] then
        return &quot;bundleable&quot;
    end

    return &quot;readable&quot;
end

function planChildren(children, threshold)
    local readable = {}
    local groups = {}

    for _, child in children do
        local kind = classifyChild(child)
        if kind == &quot;readable&quot; then
            table.insert(readable, child)
        else
            local className = string.lower(child.ClassName)
            local bucket = groups[className]
            if bucket == nil then
                bucket = {}
                groups[className] = bucket
            end
            table.insert(bucket, child)
        end
    end

    local bundled = {}
    local exploded = {}

    for className, bucket in groups do
        if #bucket &gt;= threshold then
            bundled[className] = bucket
        else
            for _, child in bucket do
                table.insert(exploded, child)
            end
        end
    end

    return {
        readable = readable,
        bundled = bundled,
        exploded = exploded,
    }
end

return {
    classifyChild = classifyChild,
    planChildren = planChildren,
}
</ProtectedString>
        </Properties>
    </Item>
</roblox>
